      "label": "Replace every fourth halo by normal segments",
      "enabled": true,
      "config": {
        "autoRun": false,
        "debug": false,
        "effectType": "splineLines",
        "splineSource": "circle",
        "splineSelector": "circle.multi-ring:nth-of-type(4n)",
