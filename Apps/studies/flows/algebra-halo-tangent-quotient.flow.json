      "kind": "effect",
      "label": "Quotient away cellular scaffolding",
      "enabled": true,
      "config": {
        "autoRun": false,
        "debug": false,
        "effectType": "paint",
        "elementType": "path",
        "selector": "g.dots circle,.outline",
        "paintFill": "none",
        "paintStroke": "none"
