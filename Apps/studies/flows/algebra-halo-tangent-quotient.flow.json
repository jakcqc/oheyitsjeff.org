        "splineStepsPerSegment": 3,
        "splineTension": 0.24,
        "splineLineOrientation": "normal",
        "splineLineHeight": 24,
        "splineLineScale": 1.2,
        "splineStrokeWidth": 0.95
      }
    },
    {
      "id": "stage-mues67dl-yol2rx8",
