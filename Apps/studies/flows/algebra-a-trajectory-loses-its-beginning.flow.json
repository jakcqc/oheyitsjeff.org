    {
      "id": "stage-mues67b3-vg1z9zt",
      "kind": "effect",
      "label": "Closed chunks emit short normal vectors",
      "enabled": true,
      "config": {
        "autoRun": false,
        "debug": false,
        "effectType": "splineLines",
        "splineSource": "polygon",
        "splineSelector": "polygon",
        "splinePointCount": 10,
        "splineStepsPerSegment": 4,
        "splineTension": 0.22,
        "splineLineOrientation": "normal",
        "splineLineHeight": 21,
        "splineLineScale": 1.3,
        "splineStrokeWidth": 1.1,
        "splineScaleMode": "none",
        "splineScaleFactor": 1
      }
    },
    {
      "id": "stage-mues67b3-hwfr1ep",
      "kind": "effect",
      "label": "Mint copper and ice lineages",
      "enabled": true,
      "config": {
        "autoRun": false,
        "debug": false,
