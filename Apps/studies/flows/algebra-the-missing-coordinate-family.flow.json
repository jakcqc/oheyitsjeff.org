{
  "schemaVersion": 1,
  "name": "The Missing Coordinate Family",
  "stages": [
    {
      "id": "stage-mues67b5-9c5vafb",
      "kind": "effect",
      "label": "Every fifth coordinate becomes a polygon",
      "enabled": true,
      "config": {
        "autoRun": false,
        "debug": false,
        "effectType": "convert",
        "convertFrom": "path",
        "convertTo": "polygon",
        "selector": "path:nth-of-type(5n)",
        "pathSamplePoints": 26,
        "convertScaleMode": "none",
        "convertScaleFactor": 1
      }
    },
    {
      "id": "stage-mues67b5-8aos56y",
      "kind": "effect",
      "label": "Selected coordinate polygons become bristles",
      "enabled": true,
      "config": {
        "autoRun": false,
        "debug": false,
        "effectType": "splineLines",
        "splineSource": "polygon",
        "splineSelector": "polygon",
        "splinePointCount": 16,
        "splineStepsPerSegment": 4,
        "splineTension": 0.22,
        "splineLineOrientation": "normal",
        "splineLineHeight": 26,
        "splineLineScale": 1.3,
        "splineStrokeWidth": 0.7,
        "splineScaleMode": "none",
        "splineScaleFactor": 1
      }
    },
    {
      "id": "stage-mues67b5-e82tl3c",
      "kind": "effect",
      "label": "Two-tone coordinate memory",
      "enabled": true,
      "config": {
        "autoRun": false,
        "debug": false,
        "effectType": "color",
        "color": {
          "selector": "path,line,polygon,g",
          "sourceProp": "each",
          "targetProp": "both",
          "mode": "byExisting",
          "colorSort": "appearance",
          "paletteText": "#161616, #777777",
          "paletteSteps": 0,
          "useComputed": true,
          "skipNone": true
        }
      }
    },
    {
      "id": "stage-mues67b5-qmcye7z",
      "kind": "transform",
      "label": "Small coordinate shear",
      "enabled": true,
      "config": {
        "stack": [
          {
            "kind": "matrix",
            "m": [
              1,
              -0.06,
              0.08,
              1,
              -52,
              45
            ]
          }
        ],
        "ui": {
          "splitMode": "fit"
        }
      }
    }
  ]
}
