{
  "schemaVersion": 1,
  "name": "Square Membranes Remember Radius",
  "stages": [
    {
      "id": "stage-mues67dm-9xekpwg",
      "kind": "effect",
      "label": "Encode radius before destroying circular type",
      "enabled": true,
      "config": {
        "autoRun": false,
        "debug": false,
        "effectType": "color",
        "color": {
          "selector": "circle.multi-ring",
          "sourceProp": "stroke",
          "targetProp": "stroke",
          "mode": "bySize",
          "colorSort": "appearance",
          "paletteText": "#39daca,#4b41a7,#ef6891,#ffd980",
          "paletteSteps": 48,
          "useComputed": true,
          "skipNone": true,
          "sizeSource": "attr",
          "sizeAttr": "r",
          "sizeMin": 15,
          "sizeMax": 210
        }
      }
    },
    {
      "id": "stage-mues67dm-v612x9u",
      "kind": "effect",
      "label": "Turn every third membrane into its bounding rectangle",
      "enabled": true,
      "config": {
        "autoRun": false,
        "debug": false,
        "effectType": "convert",
        "convertFrom": "circle",
        "convertTo": "rect",
        "selector": "circle.multi-ring:nth-of-type(3n)",
        "pathSamplePoints": 64,
        "convertScaleMode": "none",
        "convertScaleFactor": 1
      }
    },
    {
      "id": "stage-mues67dm-w3a0kv3",
      "kind": "effect",
      "label": "Spline the rectangular membranes into orthogonal cilia",
      "enabled": true,
      "config": {
        "autoRun": false,
        "debug": false,
        "effectType": "splineLines",
        "splineSource": "rect",
        "splineSelector": "rect[data-convert-run]",
        "splinePointCount": 16,
        "splineStepsPerSegment": 3,
        "splineTension": 0.24,
        "splineLineOrientation": "tangent",
        "splineLineHeight": 19,
        "splineLineScale": 1.2,
        "splineStrokeWidth": 1.25
      }
    },
    {
      "id": "stage-mues67dm-3pqdt4b",
      "kind": "transform",
      "label": "Slight oblique drift",
      "enabled": true,
      "config": {
        "stack": [
          {
            "kind": "matrix",
            "m": [
              0.985,
              -0.035,
              0.065,
              0.985,
              -33,
              38
            ]
          }
        ],
        "ui": {
          "splitMode": "fit"
        }
      }
    }
  ]
}
