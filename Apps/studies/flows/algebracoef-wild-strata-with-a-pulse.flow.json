          "targetProp": "both",
          "mode": "bySize",
          "colorSort": "appearance",
          "paletteText": "#481778,#ef3b56,#ffa32d,#f6ffb4",
          "paletteSteps": 7,
          "useComputed": true,
          "skipNone": true,
          "sizeSource": "bboxArea",
          "sizeAttr": "r"
