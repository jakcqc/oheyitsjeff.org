{
  "schemaVersion": 1,
  "name": "Strata With a Pulse",
  "stages": [
    {
      "id": "stage-mues68dw-ncxynq1",
      "kind": "effect",
      "label": "Q: convert",
      "enabled": true,
      "config": {
        "effectType": "convert",
        "selector": "path:nth-of-type(3n)",
