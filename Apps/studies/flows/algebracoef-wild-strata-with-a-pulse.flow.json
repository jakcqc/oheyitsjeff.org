        "convertTo": "polygon",
        "pathSamplePoints": 13,
        "convertScaleMode": "center",
        "convertScaleFactor": 1
      }
    },
    {
      "id": "stage-mues68dw-h0wt6sb",
      "kind": "effect",
      "label": "N: splineLines",
      "enabled": true,
      "config": {
        "effectType": "splineLines",
        "splineSource": "polygon",
        "splineSelector": "polygon",
        "splinePointCount": 13,
        "splineStepsPerSegment": 4,
        "splineTension": 3.3,
        "splineExtrapolateTension": true,
        "splineAngleOffset": 67,
        "splineLineOrientation": "vertical",
        "splineLineHeight": 46,
        "splineLineScale": 4.7,
        "splineStrokeWidth": 0.65,
        "splineScaleMode": "none",
        "splineScaleFactor": 1
      }
    },
    {
      "id": "stage-mues68dw-xy1r30h",
      "kind": "effect",
      "label": "E: scale",
      "enabled": true,
      "config": {
        "effectType": "scale",
        "elementType": "path",
        "selector": "path:nth-of-type(2n)",
