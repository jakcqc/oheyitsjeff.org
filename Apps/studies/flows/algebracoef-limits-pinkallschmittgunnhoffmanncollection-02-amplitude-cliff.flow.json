{
  "schemaVersion": 1,
  "name": "Amplitude Cliff",
  "stages": [
    {
      "id": "stage-mvc9wkd0-rom7vro",
      "kind": "effect",
      "label": "Q: convert",
      "enabled": true,
      "config": {
        "effectType": "convert",
        "selector": "path:nth-of-type(7n)",
        "convertFrom": "path",
        "convertTo": "polygon",
        "pathSamplePoints": 9,
        "convertScaleMode": "center",
        "convertScaleFactor": 1
      }
    },
    {
      "id": "stage-mvc9wkd0-582vbno",
      "kind": "effect",
      "label": "N: splineLines",
      "enabled": true,
      "config": {
        "effectType": "splineLines",
        "splineSource": "polygon",
        "splineSelector": "polygon",
        "splinePointCount": 9,
        "splineStepsPerSegment": 4,
        "splineTension": -4.5,
        "splineExtrapolateTension": true,
        "splineAngleOffset": 19,
        "splineLineOrientation": "normal",
        "splineLineHeight": 18,
        "splineLineScale": 3.7,
        "splineStrokeWidth": 0.65,
        "splineScaleMode": "none",
        "splineScaleFactor": 1
      }
    },
    {
      "id": "stage-mvc9wkd0-04ouapw",
      "kind": "effect",
      "label": "E: scale",
      "enabled": true,
      "config": {
        "effectType": "scale",
        "elementType": "path",
        "selector": "path:nth-of-type(11n)",
        "rangeMin": 0.25,
        "rangeMax": 2.5,
        "count": 5,
        "spacing": "logarithmic",
        "opacityMode": "fixed",
        "opacityFixed": 0.82,
        "equation": "sum(backward):opacity *0.72"
      }
    },
    {
      "id": "stage-mvc9wkd0-jnlh258",
      "kind": "effect",
      "label": "C: color",
      "enabled": true,
      "config": {
        "effectType": "color",
        "color": {
          "selector": "path,polygon,circle,rect,line",
          "sourceProp": "each",
          "targetProp": "stroke",
          "mode": "byIndex",
          "colorSort": "appearance",
          "paletteText": "#481778,#ef3b56,#ffa32d,#f6ffb4",
          "paletteSteps": 7,
          "useComputed": true,
          "skipNone": true,
          "sizeSource": "bboxArea",
          "sizeAttr": "r"
        }
      }
    },
    {
      "id": "stage-mvc9wkd0-mham6b1",
      "kind": "transform",
      "label": "A: folded presentation",
      "enabled": true,
      "config": {
        "stack": [
          {
            "kind": "matrix",
            "m": [
              0,
              0.78,
              0.78,
              0,
              210,
              32
            ]
          },
          {
            "kind": "rotate",
            "deg": -13
          }
        ]
      }
    }
  ]
}
