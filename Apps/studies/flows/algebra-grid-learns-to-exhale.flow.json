        "selector": "circle",
        "paintFill": "none",
        "paintStroke": "#ef8d30"
      }
    },
    {
      "id": "stage-mues67b6-jvnxdba",
      "kind": "effect",
      "label": "palette as ordered spectrum",
      "enabled": true,
      "config": {
        "effectType": "color",
        "color": {
          "selector": "circle",
          "sourceProp": "stroke",
          "targetProp": "stroke",
          "mode": "byIndex",
          "colorSort": "appearance",
