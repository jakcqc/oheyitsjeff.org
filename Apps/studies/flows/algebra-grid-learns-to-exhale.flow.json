        "splinePointCount": 16,
        "splineStepsPerSegment": 3,
        "splineTension": 0.15,
        "splineLineOrientation": "normal",
        "splineLineHeight": 49,
        "splineLineScale": 1,
        "splineStrokeWidth": 0.65,
        "splineScaleMode": "none",
        "splineScaleFactor": 1
      }
    },
    {
      "id": "stage-mues67b6-5iv5e45",
      "kind": "transform",
      "label": "small final affine change",
      "enabled": true,
      "config": {
        "stack": [
          {
            "kind": "rotate",
