      "kind": "effect",
      "label": "N2: tangent vectors, coefficient 1.35",
      "enabled": true,
      "config": {
        "effectType": "splineLines",
        "splineSource": "circle",
        "splineSelector": "circle",
        "splinePointCount": 12,
        "splineStepsPerSegment": 2,
        "splineTension": 0.2,
        "splineLineOrientation": "tangent",
        "splineLineHeight": 49,
        "splineLineScale": 1.35,
