        "selector": "circle",
        "elementType": "circle",
        "rangeMin": 0.62,
        "rangeMax": 1.25,
        "count": 2,
        "spacing": "linear",
        "opacityMode": "fixed",
        "opacityFixed": 0.72,
        "equation": ""
